   "source": [
    "import numpy as np\n",
    "\n",
    "a = np.array([2,-1])\n",
    "b = np.array([1,3])\n",
    "\n",
    "za = a[0] + 1j*a[1]\n",
    "zb = b[0] + 1j*b[1]\n",
    "\n",
    "print(\"Vector a:\",a)\n",
    "print(\"Vector b:\",b)\n",
    "\n",
    "print(\"za = \",za)\n",
    "print(\"zb = \",zb)\n",
